{
  "name": "creatortask-studio",
  "version": "1.0.0",
  "description": "Production-ready task management and YouTube video idea organizer for creators with local Qwen 2.5 AI",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "app": "electron .",
    "setup": "node setup.js",
    "icon": "node scripts/generate-icon.js",
    "build:win": "npm run icon && electron-builder --win nsis",
    "test": "node tests/api.test.js"
  },
  "build": {
    "appId": "com.creatortask.studio",
    "productName": "CreatorTask Studio",
    "copyright": "Copyright © 2026 CreatorTask Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CreatorTask-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CreatorTask Studio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!tests/**/*",
      "!.system_generated/**/*"
    ]
  },
  "keywords": [
    "tasks",
    "youtube",
    "ideas",
    "creator",
    "kanban",
    "productivity",
    "electron",
    "desktop-app",
    "windows-installer",
    "pwa"
  ],
  "author": "CreatorTask Studio",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  }
}
